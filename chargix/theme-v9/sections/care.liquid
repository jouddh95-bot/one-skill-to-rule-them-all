{%- comment -%} Care plans: one product, three variants, picked with radios and bought straight to checkout. {%- endcomment -%}
{%- assign p = section.settings.product -%}
<section class="sec" id="{{ section.settings.anchor }}" aria-labelledby="{{ section.id }}-h">
  <div class="wrap care">
    <header class="care__head" data-reveal>
      <p class="label-mono"><span class="idx">{{ section.settings.index }}</span>{{ section.settings.eyebrow }}</p>
      <h2 class="t-h2" id="{{ section.id }}-h">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
      {%- if p != blank -%}<p><a class="btn btn--text" href="{{ p.url }}">{{ 'packages.care_details' | t }} {% render 'icon', i: 'arrow' %}</a></p>{%- endif -%}
    </header>
    {%- if p != blank -%}
      {%- form 'product', p, class: 'care__form glass', data-reveal: '' -%}
        <fieldset class="plans">
          <legend class="vh">{{ p.title | escape }}</legend>
          {%- for v in p.variants -%}
            {%- assign desc_key = 'desc_' | append: forloop.index -%}
            <label class="plan">
              <input type="radio" name="id" value="{{ v.id }}"{% if forloop.first %} checked{% endif %}{% unless v.available %} disabled{% endunless %}>
              <span class="plan__radio" aria-hidden="true"></span>
              <span class="plan__txt"><span class="plan__name">{{ v.title | escape }}</span><span class="plan__desc">{{ section.settings[desc_key] }}</span></span>
              <span class="plan__price">{{ v.price | money_without_trailing_zeros }}<small>{{ 'packages.per_month' | t }}</small></span>
            </label>
          {%- endfor -%}
        </fieldset>
        <input type="hidden" name="quantity" value="1">
        <input type="hidden" name="return_to" value="/checkout">
        <button class="btn btn--lamp btn--block" type="submit" name="add">{{ 'packages.care_buy' | t }} {% render 'icon', i: 'arrow' %}</button>
        {%- if section.settings.fine != blank -%}<p class="hint">{{ section.settings.fine }}</p>{%- endif -%}
      {%- endform -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Care plans",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "care" },
    { "type": "text", "id": "index", "label": "Index number", "default": "05" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "After launch" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "product", "id": "product", "label": "Care plan product" },
    { "type": "text", "id": "desc_1", "label": "Plan 1 summary" },
    { "type": "text", "id": "desc_2", "label": "Plan 2 summary" },
    { "type": "text", "id": "desc_3", "label": "Plan 3 summary" },
    { "type": "text", "id": "fine", "label": "Fine print" }
  ],
  "presets": [ { "name": "Care plans" } ]
}
{% endschema %}

<section class="sec tone-paper" id="{{ section.settings.anchor }}" aria-labelledby="{{ section.id }}-h">
  <div class="wrap">
    <header class="sec__head" data-reveal>
      <p class="eyebrow"><span class="idx">{{ section.settings.index }}</span>{{ section.settings.eyebrow }}</p>
      <h2 class="d-2" id="{{ section.id }}-h">{{ section.settings.heading }}</h2>
    </header>
    <div class="faq">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}><summary>{{ block.settings.q }}</summary><div class="prose">{{ block.settings.a }}</div></details>
      {%- endfor -%}
    </div>
  </div>
</section>
<script type="application/ld+json">
{ "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
  {%- for block in section.blocks -%}{ "@type": "Question", "name": {{ block.settings.q | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.a | strip_html | json }} } }{% unless forloop.last %},{% endunless %}{%- endfor -%}
] }
</script>
{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "faq" },
    { "type": "text", "id": "index", "label": "Index number", "default": "06" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before you buy" }
  ],
  "blocks": [ { "type": "q", "name": "Question", "settings": [ { "type": "text", "id": "q", "label": "Question" }, { "type": "richtext", "id": "a", "label": "Answer" } ] } ],
  "presets": [ { "name": "FAQ" } ]
}
{% endschema %}

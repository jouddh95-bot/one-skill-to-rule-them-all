<section class="sec" style="min-height:100svh;display:grid;align-items:center"><div class="wrap narrow">
  <a class="hdr__logo" href="{{ routes.root_url }}">{% render 'logo' %}<span>{{ settings.brand_name | default: 'CHARGIX' }}</span></a>
  <h1 class="d-1" style="margin-top:48px">{{ 'general.password' | t }}</h1>
  {%- if shop.password_message != blank -%}<p class="lede">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'form', style: 'margin-top:48px;max-width:420px' -%}
    {%- if form.errors -%}<div class="alert alert--err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="pw">{{ 'general.password_enter' | t }}</label><input class="input" id="pw" type="password" name="password" autocomplete="current-password"></div>
    <button class="btn btn--brass" type="submit">{{ 'general.enter' | t }}</button>
  {%- endform -%}
</div></section>
{% schema %}{ "name": "Password" }{% endschema %}

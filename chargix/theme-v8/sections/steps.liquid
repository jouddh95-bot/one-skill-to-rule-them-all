<section class="sec tone-paper" id="{{ section.settings.anchor }}" aria-labelledby="{{ section.id }}-h">
  <div class="wrap">
    <header class="sec__head sec__head--split plinth" data-reveal>
      <div>
        <p class="eyebrow"><span class="idx">{{ section.settings.index }}</span>{{ section.settings.eyebrow }}</p>
        <h2 class="d-2" id="{{ section.id }}-h">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text }}</p>{%- endif -%}
    </header>
    <ol class="steps">
      {%- for block in section.blocks -%}
        <li class="step" data-reveal {{ block.shopify_attributes }}>
          <span class="idx">{{ block.settings.when }}</span>
          <h3 class="h-4">{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
    {%- if section.settings.button != blank -%}<p style="margin-top:var(--s-6)"><a class="btn btn--solid" href="{{ section.settings.link }}">{{ section.settings.button }} {% render 'icon', i: 'arrow' %}</a></p>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Steps",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "process" },
    { "type": "text", "id": "index", "label": "Index number", "default": "04" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "After you buy" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button", "label": "Button" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [ { "type": "text", "id": "when", "label": "When", "default": "Day 1" }, { "type": "text", "id": "title", "label": "Title" }, { "type": "textarea", "id": "text", "label": "Text" } ] }
  ],
  "presets": [ { "name": "Steps" } ]
}
{% endschema %}

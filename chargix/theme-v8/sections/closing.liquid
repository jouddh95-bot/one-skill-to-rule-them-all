<section class="close" aria-labelledby="{{ section.id }}-h">
  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'close__img', loading: 'lazy', widths: '800,1400,2000,2400', alt: '' }}
  {%- elsif section.settings.asset != blank -%}
    <img class="close__img" src="{{ section.settings.asset | asset_url }}" alt="" loading="lazy" width="1440" height="900">
  {%- endif -%}
  <div class="wrap close__in" data-reveal>
    <p class="eyebrow"><b>{{ section.settings.eyebrow }}</b></p>
    <h2 class="d-1" id="{{ section.id }}-h">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text }}</p>{%- endif -%}
    <div class="close__actions">
      {%- if section.settings.label != blank -%}<a class="btn btn--brass" href="{{ section.settings.link }}">{{ section.settings.label }} {% render 'icon', i: 'arrow' %}</a>{%- endif -%}
      {%- if section.settings.label2 != blank -%}<a class="btn" href="{{ section.settings.link2 }}">{{ section.settings.label2 }}</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Closing call to action",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "asset", "label": "Or background from theme assets (file name)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading (<em> allowed)" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "label", "label": "Button" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "text", "id": "label2", "label": "Second button" },
    { "type": "url", "id": "link2", "label": "Second button link" }
  ],
  "presets": [ { "name": "Closing call to action" } ]
}
{% endschema %}

<section class="sec sec--tight tone-paper" aria-labelledby="cart-h">
  <div class="wrap">
    <header class="sec__head plinth"><h1 class="d-2" id="cart-h">{{ 'cart.title' | t }}</h1></header>
    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart" novalidate>
        <div>
          <ul class="lines">
            {%- for item in cart.items -%}
              <li class="line">
                <a class="line__img" href="{{ item.url }}" tabindex="-1" aria-hidden="true">{%- if item.image -%}{{ item.image | image_url: width: 200 | image_tag: alt: '' }}{%- else -%}{% render 'icon', i: 'box' %}{%- endif -%}</a>
                <div>
                  <a class="line__t" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                  {%- unless item.product.has_only_default_variant -%}<span class="line__v">{{ item.variant.title | escape }}</span>{%- endunless -%}
                  {%- if item.selling_plan_allocation -%}<span class="line__v">{{ item.selling_plan_allocation.selling_plan.name }}</span>{%- endif -%}
                  <span class="line__v">{{ item.final_price | money }}</span>
                  <div class="line__ctl">
                    <div class="qty" data-qty><button type="button" data-step="-" aria-label="{{ 'cart.minus' | t }}">−</button><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'cart.qty' | t }}"><button type="button" data-step="+" aria-label="{{ 'cart.plus' | t }}">+</button></div>
                    <a class="line__rm" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
                  </div>
                </div>
                <span class="line__total">{{ item.final_line_price | money }}</span>
              </li>
            {%- endfor -%}
          </ul>
          <p style="margin-top:var(--s-4)"><button class="btn btn--sm" type="submit" name="update">{{ 'cart.update' | t }}</button></p>
        </div>
        <aside class="sum">
          {%- if cart.cart_level_discount_applications.size > 0 -%}
            {%- for d in cart.cart_level_discount_applications -%}<div class="sum__row small"><span>{{ d.title }}</span><span>−{{ d.total_allocated_amount | money }}</span></div>{%- endfor -%}
          {%- endif -%}
          <div class="sum__row"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></div>
          <p class="hint" style="margin:0">{{ 'cart.taxes' | t }}</p>
          <div class="field"><label for="cart-note">{{ 'cart.note' | t }}</label><textarea class="textarea" id="cart-note" name="note" rows="2">{{ cart.note }}</textarea></div>
          <button class="btn btn--brass btn--block" type="submit" name="checkout">{% render 'icon', i: 'lock' %} {{ 'cart.checkout' | t }}</button>
          <div class="pay-icons" aria-label="{{ 'general.payments' | t }}">{%- for t in shop.enabled_payment_types -%}{{ t | payment_type_svg_tag }}{%- endfor -%}</div>
        </aside>
      </form>
    {%- else -%}
      <div class="empty">
        <p class="lede">{{ 'cart.empty' | t }}</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center"><a class="btn btn--solid" href="{{ routes.root_url }}#packages">{{ 'packages.see' | t }}</a><a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'products.shop' | t }}</a></div>
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}{ "name": "Cart" }{% endschema %}

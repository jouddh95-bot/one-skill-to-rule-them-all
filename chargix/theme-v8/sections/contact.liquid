<section class="sec sec--tight tone-paper" aria-labelledby="{{ section.id }}-h">
  <div class="wrap split">
    <header>
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="d-2" id="{{ section.id }}-h">{{ page.title | default: section.settings.heading }}</h1>
      {%- if page.content != blank -%}<div class="prose" style="margin-top:var(--s-5)">{{ page.content }}</div>{%- endif -%}
      <dl class="facts">
        <div><dt>{{ section.settings.reply_title }}</dt><dd>{{ section.settings.reply_text }}</dd></div>
        <div><dt>{{ section.settings.lang_title }}</dt><dd>{{ section.settings.lang_text }}</dd></div>
        {%- if settings.contact_email != blank -%}<div><dt>Email</dt><dd><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></dd></div>{%- endif -%}
      </dl>
    </header>
    {%- form 'contact', class: 'form' -%}
      {%- if form.posted_successfully? -%}
        <div class="alert alert--ok" role="status">{{ section.settings.success }}</div>
      {%- else -%}
        {%- if form.errors -%}<div class="alert alert--err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="row row--2">
          <div class="field"><label for="c-name">{{ 'contact.name' | t }}</label><input class="input" id="c-name" name="contact[name]" autocomplete="name"></div>
          <div class="field"><label for="c-email">{{ 'contact.email' | t }} <span aria-hidden="true">*</span></label><input class="input" id="c-email" type="email" name="contact[email]" autocomplete="email" required></div>
        </div>
        <div class="field"><label for="c-topic">{{ 'contact.topic' | t }}</label><select class="select" id="c-topic" name="contact[Topic]">
          {%- assign topics = section.settings.topics | split: ',' -%}{%- for o in topics -%}<option>{{ o | strip }}</option>{%- endfor -%}
        </select></div>
        <div class="field"><label for="c-order">{{ 'contact.order' | t }}</label><input class="input" id="c-order" name="contact[Order number]"></div>
        <div class="field"><label for="c-body">{{ 'contact.message' | t }} <span aria-hidden="true">*</span></label><textarea class="textarea" id="c-body" name="contact[body]" required></textarea></div>
        <div class="form__end"><p class="hint" style="margin:0">* {{ 'contact.required' | t }}</p><button class="btn btn--solid" type="submit">{{ section.settings.submit }} {% render 'icon', i: 'arrow' %}</button></div>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>
{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Contact" },
    { "type": "text", "id": "heading", "label": "Heading (when not on a page)", "default": "Talk to us" },
    { "type": "text", "id": "reply_title", "label": "Fact 1 title", "default": "Reply time" },
    { "type": "text", "id": "reply_text", "label": "Fact 1 text", "default": "Within 1 business day." },
    { "type": "text", "id": "lang_title", "label": "Fact 2 title", "default": "Languages" },
    { "type": "text", "id": "lang_text", "label": "Fact 2 text", "default": "English or Español." },
    { "type": "textarea", "id": "topics", "label": "Topics (comma separated)", "default": "Question about a package, Custom quote, Care plan / maintenance request, Existing project, Order from the shop, Other" },
    { "type": "text", "id": "submit", "label": "Button", "default": "Send message" },
    { "type": "text", "id": "success", "label": "Success message", "default": "Thank you. We reply within 1 business day." }
  ]
}
{% endschema %}

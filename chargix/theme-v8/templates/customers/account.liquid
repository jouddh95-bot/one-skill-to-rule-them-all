<section class="sec sec--tight tone-paper"><div class="wrap">
  <header class="sec__head plinth"><p class="eyebrow">{{ customer.email }}</p><h1 class="d-2">{{ 'customer.account' | t }}</h1><p><a class="link" href="{{ routes.account_logout_url }}">{{ 'customer.logout' | t }}</a> &nbsp; <a class="link" href="{{ routes.account_addresses_url }}">{{ 'customer.addresses' | t }} ({{ customer.addresses_count }})</a></p></header>
  <h2 class="d-3" style="margin-bottom:24px">{{ 'customer.orders' | t }}</h2>
  {%- paginate customer.orders by 20 -%}
    {%- if customer.orders.size > 0 -%}
      <div class="cmp-wrap"><table class="cmp"><thead><tr><th>#</th><th>{{ 'customer.date' | t }}</th><th>{{ 'customer.status' | t }}</th><th>{{ 'customer.total' | t }}</th></tr></thead><tbody>
        {%- for o in customer.orders -%}<tr><td><a href="{{ o.customer_url }}">{{ o.name }}</a></td><td>{{ o.created_at | time_tag: format: 'date' }}</td><td>{{ o.financial_status_label }} · {{ o.fulfillment_status_label }}</td><td>{{ o.total_price | money }}</td></tr>{%- endfor -%}
      </tbody></table></div>
    {%- else -%}<p>{{ 'customer.no_orders' | t }}</p>{%- endif -%}
    {%- if paginate.pages > 1 -%}<nav class="pager">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
</div></section>

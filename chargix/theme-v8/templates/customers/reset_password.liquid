<section class="sec sec--tight tone-paper"><div class="wrap narrow">
  <header class="sec__head plinth"><h1 class="d-2">{{ 'customer.reset' | t }}</h1></header>
  {%- form 'reset_customer_password', class: 'form' -%}
    {%- if form.errors -%}<div class="alert alert--err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="p-pass">{{ 'customer.password' | t }}</label><input class="input" id="p-pass" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field"><label for="p-pass2">{{ 'customer.password' | t }}</label><input class="input" id="p-pass2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <div class="form__end"><button class="btn btn--solid" type="submit">{{ 'customer.reset' | t }}</button></div>
  {%- endform -%}
</div></section>

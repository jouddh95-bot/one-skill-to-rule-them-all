    "process": {
      "type": "cx-process",
      "blocks": {
        "step1": {
          "type": "step",
          "settings": {
            "title": "Choose & pay",
            "time": "Day 0",
            "text": "Pick a package and pay securely at checkout. You get an order email straight away with a link to your project form."
          }
        },
        "step2": {
          "type": "step",
          "settings": {
            "title": "Project form",
            "time": "~10 minutes",
            "text": "Tell us about your business, style and pages, and share your logo and photos. Your timeline starts when this is complete."
          }
        },
        "step3": {
          "type": "step",
          "settings": {
            "title": "Design",
            "time": "Week 1",
            "text": "We send a design direction for your homepage. You give feedback in one consolidated round."
          }
        },
        "step4": {
          "type": "step",
          "settings": {
            "title": "Build & set up",
            "time": "Weeks 1–4",
            "text": "We build every page, set up products, payments and shipping, and test on phones, tablets and desktops."
          }
        },
        "step5": {
          "type": "step",
          "settings": {
            "title": "Review & launch",
            "time": "Final week",
            "text": "You review, we apply your revisions, then we launch together and hand over with training."
          }
        }
      },
      "block_order": [
        "step1",
        "step2",
        "step3",
        "step4",
        "step5"
      ],
      "settings": {
        "text": "A simple, written process. You always know what happens next and what we need from you.",
        "heading": "From checkout <em>to opening day.</em>"
      }
    },

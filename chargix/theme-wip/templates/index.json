    "faq": {
      "type": "cx-faq",
      "blocks": {
        "qa1": {
          "type": "qa",
          "settings": {
            "q": "How do I pay?",
            "a": "<p>You pay the full package price online at checkout with card, Shop Pay, Apple Pay or Google Pay. Prices are in USD.</p>"
          }
        },
        "qa2": {
          "type": "qa",
          "settings": {
            "q": "When does my project start?",
            "a": "<p>Right after checkout you get a link to a short project form. Your timeline starts once the form and your files (logo, photos, product info) are in. We confirm your start date within 1 business day.</p>"
          }
        },
        "qa3": {
          "type": "qa",
          "settings": {
            "q": "Do I need a Shopify plan?",
            "a": "<p>Yes. Your store runs on your own Shopify account and plan, which you pay Shopify for directly. If you don't have one yet, we help you open it. Domains, paid apps and premium themes are also paid by you.</p>"
          }
        },
        "qa4": {
          "type": "qa",
          "settings": {
            "q": "What counts as a revision round?",
            "a": "<p>One consolidated list of changes on the current design. A completely new direction is a new project. Extra rounds can be added at our hourly rate.</p>"
          }
        },
        "qa5": {
          "type": "qa",
          "settings": {
            "q": "Is the 3D real?",
            "a": "<p>Yes. The 3D Experience package includes a real-time WebGL scene that visitors can interact with, plus a lightweight fallback for older phones so the site stays fast.</p>"
          }
        },
        "qa6": {
          "type": "qa",
          "settings": {
            "q": "Can you guarantee sales?",
            "a": "<p>No one honestly can. We build a fast, trustworthy, properly configured store and help you prepare marketing. Results depend on your product, pricing and promotion.</p>"
          }
        },
        "qa7": {
          "type": "qa",
          "settings": {
            "q": "Do you run my ads?",
            "a": "<p>Business Launch includes setting up your Meta and TikTok accounts and pixels and preparing one campaign draft. Running ads and the ad budget are separate.</p>"
          }
        },
        "qa8": {
          "type": "qa",
          "settings": {
            "q": "Do you work in Spanish?",
            "a": "<p>Sí. We work with clients in the US and México in English or Spanish, and can build your site in both languages.</p>"
          }
        },
        "qa9": {
          "type": "qa",
          "settings": {
            "q": "What is your refund policy?",
            "a": "<p>Full refund before you submit the project form, 50% refund after the form and before we deliver the first design, and no refund after the first design is delivered. Full details are on our refund policy page.</p>"
          }
        },
        "qa10": {
          "type": "qa",
          "settings": {
            "q": "What happens after launch?",
            "a": "<p>Every package includes free post-launch fixes (14 or 30 days). After that you can add a monthly Care plan for checks, edits and support, or contact us when you need something.</p>"
          }
        }
      },

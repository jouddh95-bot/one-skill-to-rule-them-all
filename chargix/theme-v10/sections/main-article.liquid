<article class="sec sec--page"><div class="wrap">
  <header class="head"><p class="label-mono">{{ article.published_at | time_tag: format: 'date' }}</p><h1 class="t-h2">{{ article.title | escape }}</h1></header>
  {%- if article.image -%}{{ article.image | image_url: width: 1600 | image_tag: alt: article.title, style: 'border-radius:10px;margin-bottom:48px' }}{%- endif -%}
  <div class="prose">{{ article.content }}</div>
</div></article>
{% schema %}{ "name": "Article" }{% endschema %}

{%- liquid
  assign brand = settings.brand_name | default: 'CHARGIX'
  assign og_title = page_title | default: brand
  if shop.name != blank and shop.name != brand
    assign og_title = og_title | replace: shop.name, brand
  endif
  if request.page_type == 'index'
    assign og_title = brand | append: ' – Websites and 3D experiences that turn ideas into businesses'
  endif
  assign og_description = page_description | default: settings.default_description
  if request.page_type == 'index'
    assign og_description = settings.default_description
  endif
  assign og_description = og_description | strip_html | strip_newlines | truncate: 200
-%}
<meta property="og:site_name" content="{{ brand }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:locale" content="{% if request.locale.iso_code == 'es' %}es_MX{% else %}en_US{% endif %}">
{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
{%- elsif settings.share_image != blank -%}
  <meta property="og:image" content="https:{{ settings.share_image | image_url: width: 1200 }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if request.page_type == 'index' and template.suffix == blank -%}
<script type="application/ld+json">
{ "@context": "https://schema.org", "@type": "ProfessionalService", "name": {{ brand | json }}, "url": {{ shop.url | json }}, "description": {{ settings.default_description | json }}, "areaServed": ["US", "MX"], "knowsLanguage": ["en", "es"], "priceRange": "$750–$2,750", "email": {{ settings.contact_email | json }} }
</script>
{%- endif -%}

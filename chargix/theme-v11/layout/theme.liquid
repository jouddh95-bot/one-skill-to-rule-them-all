<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#0a0909">
    <meta name="color-scheme" content="dark">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      {%- comment -%} The box on its plinth, lit by one warm lamp. {%- endcomment -%}
      <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%230f0e11'/%3E%3Cpath d='M7 21V10l9-4v11z' fill='%23f2a65a'/%3E%3Cpath d='M16 17V6l9 4v11z' fill='%23f3eee7'/%3E%3Cpath d='M5 22l11 4 11-4-11-4z' fill='%23f3eee7' opacity='.35'/%3E%3C/svg%3E">
    {%- endif -%}
    {%- liquid
      assign brand = settings.brand_name | default: 'CHARGIX'
      assign cx_title = page_title
      if shop.name != blank and shop.name != brand
        assign cx_title = page_title | replace: shop.name, brand
      endif
      if request.page_type == 'index' and template.suffix == blank
        assign cx_title = brand | append: ' – Websites and 3D experiences that turn ideas into businesses'
      endif
    -%}
    <title>
      {{ cx_title }}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless cx_title contains brand %} &ndash; {{ brand }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- elsif settings.default_description != blank -%}
      <meta name="description" content="{{ settings.default_description | escape }}">
    {%- endif -%}
    {% render 'meta' %}
    {%- comment -%} Self-hosted type: Instrument Serif (display), Inter Tight (UI), JetBrains Mono (labels). {%- endcomment -%}
    <link rel="preload" href="{{ 'instrument-serif-latin-400-normal.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'inter-tight-latin-wght-normal.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <style>
      @font-face { font-family: 'Instrument Serif'; src: url({{ 'instrument-serif-latin-400-normal.woff2' | asset_url }}) format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
      @font-face { font-family: 'Instrument Serif'; src: url({{ 'instrument-serif-latin-400-italic.woff2' | asset_url }}) format('woff2'); font-weight: 400; font-style: italic; font-display: swap; }
      @font-face { font-family: 'Inter Tight'; src: url({{ 'inter-tight-latin-wght-normal.woff2' | asset_url }}) format('woff2'); font-weight: 100 900; font-style: normal; font-display: swap; }
      @font-face { font-family: 'JetBrains Mono'; src: url({{ 'jetbrains-mono-latin-400-normal.woff2' | asset_url }}) format('woff2'); font-weight: 400 500; font-style: normal; font-display: swap; }
    </style>
    {{ 'cx.css' | asset_url | stylesheet_tag }}
    {%- if template.suffix contains 'demo' -%}{{ 'cx-demo.css' | asset_url | stylesheet_tag }}{%- endif -%}
    <script>document.documentElement.classList.replace('no-js', 'js');</script>
    <script src="{{ 'cx.js' | asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="t-{{ template.name }}{% if template.suffix %} t-{{ template.name }}--{{ template.suffix }}{% endif %}">
    <a class="skip" href="#main">{{ 'general.skip' | t }}</a>
    {%- unless template.suffix contains 'demo' -%}{% sections 'header-group' %}{%- endunless -%}
    <main id="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {%- unless template.suffix contains 'demo' -%}{% sections 'footer-group' %}{%- endunless -%}
  </body>
</html>

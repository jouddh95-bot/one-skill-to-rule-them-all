{%- comment -%}
  CHARGIX v3 "MONUMENT" · Package demos ("the three rooms").
  One room per real package. Each room = CHARGIX-styled intro (price, scope disclosure, buy link),
  a light seam that draws down the intro into a wall gate, and a fictional concept website.
  01 Essential  → Mercer & Vane (tailoring atelier), browser + phone tour    · assets/demos.js
  02 3D         → Maison Solenne pavilion (walk-in three.js space, demos-pavilion.js), then the
                   Ligne 39 product scene (three.js watch)                   · assets/demos-3d.js
  03 Launch also carries the store-admin console (settings the package configures).
  Room 01 has no gate or cinematic motion on purpose: the Essential package is a calm site.
  03 Launch     → Casa Ocre (homeware, US/MX, EN/ES), full store + brand kit · assets/demos-shop.js
  Everything is readable without JS, without WebGL and with reduced motion.
{%- endcomment -%}
{%- liquid
  assign cl = section.settings.concept_label | default: 'Concept demo · fictional brand'
-%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=Figtree:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Italiana&family=Manrope:wght@300..700&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=Figtree:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Italiana&family=Manrope:wght@300..700&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&display=swap"></noscript>
{{ 'demos.css' | asset_url | stylesheet_tag }}
{{ 'demos-2.css' | asset_url | stylesheet_tag }}
{{ 'demos-3.css' | asset_url | stylesheet_tag }}

<section id="demos" class="dm" aria-labelledby="{{ section.id }}-h"
  data-dm
  data-mod-watch="{{ 'demos-3d.js' | asset_url }}"
  data-sl-film="{{ 'sl-film.js' | asset_url }}"
  data-sl-film-base="{{ 'sl-film.js' | asset_url | split: 'sl-film.js' | first }}"
  data-sl-film-n="180"
  data-sl-film-cws="steel"
  data-mod-pavilion="{{ 'demos-pavilion.js' | asset_url }}"
  data-mod-casa="{{ 'demos-casa.js' | asset_url }}"
  data-cs-hdr="{{ 'casa-sky.hdr' | asset_url }}"
  data-cs-sofa="{{ 'casa-sofa.glb' | asset_url }}"
  data-cs-chair="{{ 'casa-chair.glb' | asset_url }}"
  data-cs-pouf="{{ 'casa-pouf.glb' | asset_url }}"
  data-cs-cup="{{ 'casa-cup.glb' | asset_url }}"
  data-cs-lamp="{{ 'casa-lamp.glb' | asset_url }}"
  data-mod-shop="{{ 'demos-shop.js' | asset_url }}"
  data-still-steel="{{ 'demos-watch-steel.webp' | asset_url }}"
  data-still-gold="{{ 'demos-watch-gold.webp' | asset_url }}"
  data-still-titanium="{{ 'demos-watch-titanium.webp' | asset_url }}"
  data-still-exploded="{{ 'demos-watch-exploded.webp' | asset_url }}">

  <header class="dm-head">
    <p class="dm-label"><span aria-hidden="true">Rooms 01–03</span>{{ section.settings.eyebrow }}</p>
    <h2 class="dm-head__h" id="{{ section.id }}-h">{{ section.settings.heading }}{%- if section.settings.heading_em != blank -%} <em>{{ section.settings.heading_em }}</em>{%- endif -%}</h2>
    {%- if section.settings.intro != blank -%}<p class="dm-head__p">{{ section.settings.intro }}</p>{%- endif -%}
    <ol class="dm-head__toc" aria-label="Rooms">
      <li><a href="#demo-essential"><span>Room 01</span>{{ section.settings.ch1_name }} <b>{{ section.settings.ch1_price }}</b>{%- if section.settings.ch1_kind != blank -%}<em>{{ section.settings.ch1_kind }}</em>{%- endif -%}</a></li>
      <li><a href="#demo-3d"><span>Room 02</span>{{ section.settings.ch2_name }} <b>{{ section.settings.ch2_price }}</b>{%- if section.settings.ch2_kind != blank -%}<em>{{ section.settings.ch2_kind }}</em>{%- endif -%}</a></li>
      <li><a href="#demo-launch"><span>Room 03</span>{{ section.settings.ch3_name }} <b>{{ section.settings.ch3_price }}</b>{%- if section.settings.ch3_kind != blank -%}<em>{{ section.settings.ch3_kind }}</em>{%- endif -%}</a></li>
    </ol>
  </header>

  {%- for n in (1..3) -%}
    {%- liquid
      assign k = 'ch' | append: n
      assign k_name = k | append: '_name'
      assign k_head = k | append: '_heading'
      assign k_em = k | append: '_heading_em'
      assign k_intro = k | append: '_intro'
      assign k_price = k | append: '_price'
      assign k_meta = k | append: '_meta'
      assign k_handle = k | append: '_handle'
      assign k_button = k | append: '_button'
      assign k_scope = k | append: '_scope'
      assign k_not = k | append: '_not'
      assign k_shows = k | append: '_shows'
      assign k_skip = k | append: '_skip'
      assign shows = section.settings[k_shows] | split: '|'
      case n
        when 1
          assign cid = 'demo-essential'
        when 2
          assign cid = 'demo-3d'
        else
          assign cid = 'demo-launch'
      endcase
      assign scope_lines = section.settings[k_scope] | newline_to_br | split: '<br />'
    -%}
  <article class="dm-ch dm-ch--{{ n }}" id="{{ cid }}" aria-labelledby="{{ cid }}-h" data-dm-ch data-room="0{{ n }}">
    <div class="dm-seam" aria-hidden="true" data-dm-seam></div>
    <header class="dm-intro">
      <div class="dm-intro__a">
        <p class="dm-eyebrow"><span><svg viewBox="0 0 9 14" aria-hidden="true"><rect x=".5" y=".5" width="8" height="13" fill="none" stroke="currentColor"/><rect x="4" y="3" width="1" height="10.5" fill="#c8a26a"/></svg>Room 0{{ n }}</span><i aria-hidden="true"></i>{{ section.settings[k_name] }}</p>
        <h3 class="dm-h" id="{{ cid }}-h">{{ section.settings[k_head] }}{%- if section.settings[k_em] != blank -%} <em>{{ section.settings[k_em] }}</em>{%- endif -%}</h3>
      </div>
      <div class="dm-intro__b">
        <ol class="dm-ladder" aria-label="Where this package sits">
          <li class="{% if n == 1 %}is-here{% else %}is-in{% endif %}"{% if n == 1 %} aria-current="true"{% endif %}><span>01</span>{{ section.settings.ladder_1 }}</li>
          <li class="{% if n == 2 %}is-here{% elsif n == 3 %}is-in{% endif %}"{% if n == 2 %} aria-current="true"{% endif %}><span>02</span>{{ section.settings.ladder_2 }}</li>
          <li class="{% if n == 3 %}is-here{% endif %}"{% if n == 3 %} aria-current="true"{% endif %}><span>03</span>{{ section.settings.ladder_3 }}</li>
        </ol>
        <p class="dm-lede">{{ section.settings[k_intro] }}</p>
        {%- if section.settings[k_shows] != blank -%}
        <div class="dm-shows">
          <p class="dm-shows__l">{{ section.settings.shows_label }}</p>
          <ul>{%- for t in shows -%}{%- assign t2 = t | strip -%}{%- if t2 != blank -%}<li>{{ t2 }}</li>{%- endif -%}{%- endfor -%}</ul>
          {%- if section.settings[k_skip] != blank -%}<p class="dm-shows__skip">{{ section.settings[k_skip] }}</p>{%- endif -%}
        </div>
        {%- endif -%}
        <div class="dm-price">
          <span class="dm-price__l">Package price</span>
          <span class="dm-price__v">{{ section.settings[k_price] }}</span>
          <span class="dm-price__m">{{ section.settings[k_meta] }}</span>
        </div>
        <div class="dm-cta">
          <a class="dm-btn dm-btn--solid" href="/products/{{ section.settings[k_handle] }}"><span>{{ section.settings[k_button] }}</span></a>
          <button type="button" class="dm-btn dm-btn--line" aria-expanded="false" aria-controls="{{ cid }}-scope" data-dm-scope>
            <span>See what’s included</span><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4.5l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
          </button>
        </div>
        <div class="dm-scope" id="{{ cid }}-scope" hidden>
          <ul class="dm-scope__list">
            {%- for line in scope_lines -%}{%- assign l = line | strip -%}{%- if l != blank -%}<li>{{ l }}</li>{%- endif -%}{%- endfor -%}
          </ul>
          {%- if section.settings[k_not] != blank -%}<p class="dm-scope__not">{{ section.settings[k_not] }}</p>{%- endif -%}
        </div>
      </div>
    </header>
    {%- unless n == 1 -%}
    <div class="dm-gatepos" aria-hidden="true"><div class="dm-gate" data-dm-gate><i class="dm-gate__l"></i><i class="dm-gate__r"></i><i class="dm-gate__glow"></i><span class="dm-gate__plate">Room 0{{ n }} · {{ section.settings[k_name] }}</span></div></div>
    {%- endunless -%}

    {%- case n -%}
    {%- when 1 -%}
    {%- comment -%} ═════════════ ROOM 01 · MERCER & VANE (Essential) ═════════════ {%- endcomment -%}
    <div class="ess" data-ess>
      <div class="ess-track" data-ess-track>
        <div class="ess-stage" data-ess-stage>
          <div class="ess-room" aria-hidden="true"><i class="ess-room__win"></i><i class="ess-room__rail"></i></div>

          <aside class="ess-tour" aria-label="Tour of the demo homepage">
            <p class="ess-tour__tag"><span class="dm-dot" aria-hidden="true"></span>{{ cl }}</p>
            <p class="ess-tour__brand">Mercer <i>&amp;</i> Vane</p>
            <p class="ess-tour__what">A two-person tailoring atelier. Five-page site on a premium theme, customised to the brand.</p>
            <ol class="ess-steps" data-ess-steps>
              <li><button type="button" data-ess-go="0"><span>01</span>Hero &amp; navigation</button></li>
              <li><button type="button" data-ess-go="1"><span>02</span>Services, in tabs</button></li>
              <li><button type="button" data-ess-go="2"><span>03</span>About the workroom</button></li>
              <li><button type="button" data-ess-go="3"><span>04</span>Contact form</button></li>
            </ol>
            <div class="ess-meter" aria-hidden="true"><i data-ess-meter></i></div>
          </aside>

          <div class="ess-devices">
            <figure class="ess-browser">
              <div class="ess-browser__bar" aria-hidden="true">
                <span class="ess-dots"><i></i><i></i><i></i></span>
                <span class="ess-url"><svg viewBox="0 0 12 12"><path d="M3.5 5.5V4a2.5 2.5 0 015 0v1.5M3 5.5h6v4.5H3z" fill="none" stroke="currentColor" stroke-width="1.1"/></svg>mercer-and-vane.demo</span>
                <span class="ess-bar-r"></span>
              </div>
              <div class="ess-view" data-ess-view tabindex="0" role="region" aria-label="Mercer &amp; Vane demo homepage">
                <div class="mv" data-mv>
                  <p class="mv-ann">Fittings by appointment · Tuesday to Saturday · Alterations ready in about a week</p>
                  <header class="mv-hdr">
                    <a class="mv-logo" href="#demo-essential" data-mv-top aria-label="Mercer and Vane, top of demo page">
                      <svg viewBox="0 0 40 40" aria-hidden="true"><path d="M7 5h9l4 13 4-13h9L28 35H12z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/><path d="M16 5l4 13-6-3-2 3zM24 5l-4 13 6-3 2 3z" fill="currentColor"/><circle cx="20" cy="25" r="1.6" fill="#a93a2a"/><circle cx="20" cy="30.5" r="1.6" fill="#a93a2a"/></svg>
                      <span>Mercer <i>&amp;</i> Vane</span>
                    </a>
                    <nav class="mv-nav" aria-label="Mercer and Vane demo">
                      <button type="button" data-mv-link="1" data-mv-tab="shop">Shop</button>
                      <button type="button" data-mv-link="1" data-mv-tab="measure">Made to measure</button>
                      <button type="button" data-mv-link="1" data-mv-tab="alter">Alterations</button>
                      <button type="button" data-mv-link="2">About</button>
                      <button type="button" data-mv-link="3">Contact</button>
                    </nav>
                    <button type="button" class="mv-bag" data-mv-bag>Bag <span data-mv-count>0</span></button>
                    <button type="button" class="mv-burger" aria-expanded="false" data-mv-burger aria-label="Menu"><i></i><i></i></button>
                  </header>

                  <section class="mv-hero" data-mv-sec="0" aria-label="Hero">
                    <div class="mv-hero__copy">
                      <p class="mv-kicker">Tailoring atelier · est. 2016</p>
                      <h4 class="mv-hero__h">Clothes cut for one person, <em>finished by hand.</em></h4>
                      <p class="mv-hero__p">Made-to-measure suits, shirts and careful alterations from a two-person workroom. Every piece is cut on our table and fitted at least twice.</p>
                      <div class="mv-hero__cta">
                        <button type="button" class="mv-btn" data-mv-link="1" data-mv-tab="measure">Book a fitting</button>
                        <button type="button" class="mv-btn mv-btn--line" data-mv-link="1" data-mv-tab="shop">Shop the accessories</button>
                      </div>
                      <p class="mv-hero__note"><span>Now booking</span> November fittings · four to six weeks from first measure</p>
                    </div>
                    <div class="mv-hero__art">
                      <div class="mv-arch" data-mv-art="hero" role="img" aria-label="Illustration: a half-made navy jacket on a dress form, with chalk marks, basting stitches and a tape measure"></div>
                      <span class="mv-stamp" aria-hidden="true">
                        <svg viewBox="0 0 100 100"><defs><path id="mvc" d="M50 50m-38 0a38 38 0 1076 0a38 38 0 10-76 0"/></defs><text><textPath href="#mvc" textLength="232" lengthAdjust="spacing">Cut by hand · Fitted twice ·</textPath></text></svg>
                        <b>M&amp;V</b>
                      </span>
                    </div>
                  </section>

                  <ul class="mv-facts" aria-label="Atelier promises">
                    <li><b>Cut by hand</b> on our own table, from your paper pattern</li>
                    <li><b>Two fittings</b> included with every commission</li>
                    <li><b>Free pressing</b> for anything we have made</li>
                  </ul>

                  <section class="mv-svc" data-mv-sec="1" aria-labelledby="mv-svc-h">
                    <div class="mv-svc__top">
                      <p class="mv-kicker">What we make</p>
                      <h4 class="mv-h" id="mv-svc-h">Tailoring for ordinary days <em>and very good ones.</em></h4>
                    </div>
                    <div class="mv-tabs" role="tablist" aria-label="Services">
                      <button type="button" role="tab" id="mv-t-shop" aria-controls="mv-p-shop" aria-selected="true" data-mv-tabbtn="shop">Shop</button>
                      <button type="button" role="tab" id="mv-t-measure" aria-controls="mv-p-measure" aria-selected="false" tabindex="-1" data-mv-tabbtn="measure">Made to measure</button>
                      <button type="button" role="tab" id="mv-t-alter" aria-controls="mv-p-alter" aria-selected="false" tabindex="-1" data-mv-tabbtn="alter">Alterations</button>
                    </div>
                    <div class="mv-panel" role="tabpanel" id="mv-p-shop" aria-labelledby="mv-t-shop">
                      <ul class="mv-cards">
                        <li class="mv-card"><div class="mv-card__art" data-mv-art="square" role="img" aria-label="Illustration: a folded silk pocket square in a jacket pocket"></div><p class="mv-card__t">Silk Pocket Square</p><p class="mv-card__m">Hand-rolled edges</p><p class="mv-card__p">$45</p><button type="button" class="mv-add" data-mv-add>Add to bag</button></li>
                        <li class="mv-card"><div class="mv-card__art" data-mv-art="shirt" role="img" aria-label="Illustration: a folded white shirt in a box"></div><p class="mv-card__t">The Oxford Shirt</p><p class="mv-card__m">Made to measure, one fitting</p><p class="mv-card__p">$185</p><button type="button" class="mv-add" data-mv-add>Add to bag</button></li>
                        <li class="mv-card"><div class="mv-card__art" data-mv-art="gift" role="img" aria-label="Illustration: a gift card and envelope tied with thread"></div><p class="mv-card__t">Gift Card</p><p class="mv-card__m">Any amount, for any service</p><p class="mv-card__p">from $100</p><button type="button" class="mv-add" data-mv-add>Add to bag</button></li>
                      </ul>
                    </div>
                    <div class="mv-panel" role="tabpanel" id="mv-p-measure" aria-labelledby="mv-t-measure" hidden>
                      <div class="mv-list">
                        <div><p class="mv-list__t">Two-piece suit</p><p>Cut from your own pattern, two fittings, finished in about six weeks.</p><p class="mv-list__p">from $1,450</p></div>
                        <div><p class="mv-list__t">Tailored jacket</p><p>Soft-shouldered or fully canvassed, in any cloth from our books.</p><p class="mv-list__p">from $980</p></div>
                        <div><p class="mv-list__t">Trousers</p><p>Pleated or flat front, with a waistband you can let out later.</p><p class="mv-list__p">from $340</p></div>
                      </div>
                    </div>
                    <div class="mv-panel" role="tabpanel" id="mv-p-alter" aria-labelledby="mv-t-alter" hidden>
                      <ul class="mv-turn">
                        <li><span class="mv-turn__d">Ready<b>05</b>days</span><span><b>Hems and cuffs</b> Trousers, sleeves and skirts</span><span class="mv-list__p">$25</span></li>
                        <li><span class="mv-turn__d">Ready<b>07</b>days</span><span><b>Take in or let out</b> Jackets, waists and seats</span><span class="mv-list__p">$60</span></li>
                        <li><span class="mv-turn__d">Ready<b>10</b>days</span><span><b>Re-line a coat</b> New lining, finished by hand</span><span class="mv-list__p">$180</span></li>
                      </ul>
                    </div>
                  </section>

                  <section class="mv-about" data-mv-sec="2" aria-labelledby="mv-about-h">
                    <div class="mv-about__art" data-mv-art="bench" role="img" aria-label="Illustration: the cutting table from above, with shears, thread spools, chalk and a tape measure"></div>
                    <div class="mv-about__copy">
                      <p class="mv-kicker">The workroom</p>
                      <h4 class="mv-h" id="mv-about-h">Two tailors, one long cutting table and <em>no shortcuts.</em></h4>
                      <p>We draft a paper pattern for every client and keep it on file, so your second suit is quicker than your first. Buttonholes are sewn by hand, and every piece is pressed before you collect it.</p>
                      <dl class="mv-about__facts"><div><dt>Open</dt><dd>Tue–Sat, 10–6</dd></div><div><dt>Fittings</dt><dd>By appointment</dd></div><div><dt>Collection</dt><dd>At the workroom</dd></div></dl>
                    </div>
                  </section>

                  <section class="mv-contact" data-mv-sec="3" aria-labelledby="mv-ct-h">
                    <div class="mv-contact__copy">
                      <p class="mv-kicker">Book a fitting</p>
                      <h4 class="mv-h" id="mv-ct-h">Tell us what you <em>have in mind.</em></h4>
                      <p>We reply within one working day. A first fitting takes about an hour.</p>
                      <p class="mv-contact__addr">Unit 3, Foundry Yard<br>Mercer Street</p>
                    </div>
                    <form class="mv-form" data-mv-form novalidate>
                      <div class="mv-f"><label for="mv-name">Your name</label><input id="mv-name" name="name" autocomplete="off" required></div>
                      <div class="mv-f"><label for="mv-mail">Email</label><input id="mv-mail" name="email" type="email" autocomplete="off" required></div>
                      <div class="mv-f"><label for="mv-kind">Interested in</label><select id="mv-kind" name="kind"><option>A suit</option><option>A jacket</option><option>Shirts</option><option>Alterations</option></select></div>
                      <div class="mv-f"><label for="mv-date">Preferred date</label><input id="mv-date" name="date" type="date"></div>
                      <div class="mv-f mv-f--w"><label for="mv-msg">Message</label><textarea id="mv-msg" name="message" rows="3"></textarea></div>
                      <button type="submit" class="mv-btn">Send enquiry</button>
                      <p class="mv-form__note" role="status" aria-live="polite" data-mv-note></p>
                    </form>
                  </section>

                  <footer class="mv-ftr">
                    <span class="mv-ftr__logo">Mercer <i>&amp;</i> Vane</span>
                    <span>Shop · Made to measure · Alterations · About · Contact</span>
                    <span>@mercerandvane.demo</span>
                  </footer>
                </div>
              </div>
            </figure>

            <figure class="ess-phone" aria-hidden="true">
              <span class="ess-phone__notch"></span>
              <div class="ess-phone__screen" data-ess-phone></div>
            </figure>
          </div>

          <p class="ess-caption"><span class="dm-dot" aria-hidden="true"></span>{{ cl }} · Mercer &amp; Vane is not a real business. Shown at desktop and phone width.</p>
        </div>
      </div>
    </div>

    {%- when 2 -%}
    {%- comment -%} ═════════════ ROOM 02 · SOLENNE (3D Experience) ═════════════ {%- endcomment -%}
    {%- comment -%} The pavilion: a walk-in real-time 3D space (demos-pavilion.js). Without WebGL or with
      reduced motion it is hidden and the product scene below carries the room. {%- endcomment -%}
    <div class="pv" data-pv>
      <div class="pv-track" data-pv-track>
        <div class="pv-stage" data-pv-stage>
          <canvas class="pv-canvas" data-pv-canvas role="img" aria-label="Real-time 3D walk through the Maison Solenne pavilion: a lacquered facade with pivot doors, a gallery of three vitrines and a round salon. Scroll to move through it, click a vitrine to open it."></canvas>
          <nav class="pv-nav" aria-label="Maison Solenne demo navigation">
            <span class="pv-logo">SOLENNE</span>
            <span class="pv-nav__l"><span>Maison</span><span>Gallery</span><span>Salon</span></span>
            <span class="pv-tag"><span class="dm-dot" aria-hidden="true"></span>{{ cl }}</span>
          </nav>
          <div class="pv-cap pv-cap--a" data-pv-cap data-a="0" data-b="13">
            <p class="pv-k">Maison Solenne · Geneva</p>
            <p class="pv-h">A house <em>for one watch.</em></p>
            <p class="pv-p">Scroll to walk in. The doors open as you reach them.</p>
          </div>
          <div class="pv-cap pv-cap--b" data-pv-cap data-a="27" data-b="56">
            <p class="pv-k">The gallery</p>
            <p class="pv-h">Three finishes, <em>under glass.</em></p>
            <div class="pv-picks" role="group" aria-label="Open a vitrine">
              <button type="button" data-pv-pick="steel">Steel · Ink</button><button type="button" data-pv-pick="gold">Gold · Malachite</button><button type="button" data-pv-pick="titanium">Titanium · Blush</button>
            </div>
          </div>
          <div class="pv-cap pv-cap--c" data-pv-cap data-a="70" data-b="100">
            <p class="pv-k">The salon</p>
            <p class="pv-h">Time, <em>held still.</em></p>
            <p class="pv-p">The finish you opened in the gallery waits here. Keep scrolling to configure it.</p>
          </div>
          <div class="pv-hud">
            <span class="pv-hud__bar" aria-hidden="true"><i data-pv-meter></i></span>
            <span class="pv-hud__hint" data-pv-hint aria-hidden="true">Scroll to walk · drag to look · click a vitrine</span>
            <button type="button" class="pv-door" data-pv-door aria-pressed="false">Open the doors</button>
          </div>
        </div>
      </div>
